# Copy to .env and fill in. .env is ignored by git.
# Endpoints and deployment names only: no keys. The code signs in with
# DefaultAzureCredential (your az or azd sign-in locally).

# Foundry project endpoint
HINDCAST_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Foundry resource endpoint, for Content Understanding
HINDCAST_CU_ENDPOINT=https://<resource>.services.ai.azure.com/
# The deployment Content Understanding's analyzers run on (their completion model)
HINDCAST_EXTRACTION_DEPLOYMENT=<extraction-deployment>

HINDCAST_CHAT_DEPLOYMENT=<chat-deployment>
HINDCAST_COMPARE_DEPLOYMENT=<comparison-deployment>
HINDCAST_JUDGE_DEPLOYMENT=<judge-deployment>
# Foundry resource endpoint, for embeddings (the project endpoint serves none)
HINDCAST_EMBEDDING_ENDPOINT=https://<resource>.services.ai.azure.com/
HINDCAST_EMBEDDING_DEPLOYMENT=<embedding-deployment>
# Foundry resource endpoint, for Prompt Shields and PII detection
HINDCAST_SAFETY_ENDPOINT=https://<resource>.services.ai.azure.com/
# Optional, default 1024
HINDCAST_EMBEDDING_DIMENSIONS=1024

HINDCAST_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
HINDCAST_SEARCH_INDEX=hindcast-library-1024

HINDCAST_STORAGE_URL=https://<storage-account>.blob.core.windows.net
# Optional: Application Insights connection string for traces. It can write
# telemetry and read nothing; without it the commands send no telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string>

# Offline judge only (python -m hindcast.evaluation.judge), never the page or
# the investigator: an Anthropic API key.
ANTHROPIC_API_KEY=<anthropic-api-key>
